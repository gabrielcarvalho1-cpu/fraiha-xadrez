; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FRAIHA Xadrez V0.30 - En Passant Temas e Perfil"
config/use_custom_user_dir=true
config/custom_user_dir_name="FRAIHA Xadrez Musicas V026 Teste"
run/main_scene="res://presentation_v019/stage.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.03, 0.02, 0.015, 1)
boot_splash/image="res://branding/fraiha_loading_splash_r63.png"
boot_splash/image.android="res://branding/android/splash_portrait.png"
boot_splash/minimum_display_time=1200

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/mode=4
window/size/mode.web=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[rendering]

textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[audio]

general/default_playback_type.web=1
driver/output_latency.web=60

[gui]

timers/tooltip_delay_sec=3600.0
theme/default_font_multichannel_signed_distance_field=true

[editor_plugins]

enabled=PackedStringArray("res://addons/fraiha_voice_android/plugin.cfg")
